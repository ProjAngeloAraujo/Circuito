PORT=3000
FRONTEND_URL=http://localhost:5173

# Pesquisa com IA (ficha técnica e preços). Sem a chave, os endpoints /pesquisa/* respondem 503.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Listas de domínios separadas por vírgula. Vazio usa a lista inicial do código,
# que deve ser revisada: quem decide quais lojas são confiáveis é você.
LOJAS_PERMITIDAS=
FABRICANTES_PERMITIDOS=

# Validade do cache em memória
OFERTAS_TTL_HORAS=6
FICHAS_TTL_DIAS=30
